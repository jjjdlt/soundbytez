# Copy to backend/.env and fill in from Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SECRET key (sb_secret_...) or legacy service_role key. Server-only — never commit or ship to the browser.
SUPABASE_SECRET_KEY=

# Optional: per-user storage quota for saved stems, in MB (default 500 ≈ 7 five-minute songs).
# SBZ_USER_QUOTA_MB=500
